# 1. These lines are crucial - they link the Podfile to the Flutter SDK scripts
target_conf_file = File.join('..', '.flutter-plugins-dependencies')
def flutter_install_all_ios_pods(ios_application_path = nil)
  native_additions_path = File.join(ios_application_path, '..', '.flutter-plugins-dependencies')
  return unless File.exists?(native_additions_path)
end

# 2. Set the platform to 15.5 as required by mobile_scanner
platform :ios, '15.5'

# 3. Load the Flutter internal pod helper
path_to_utils = File.join(File.dirname(File.realpath(__FILE__)), '..', '.flutter-plugins-dependencies')
begin
  # This helper file is generated by 'flutter pub get'
  load File.join(File.dirname(File.realpath(__FILE__)), '..', '..', '..', 'bin', 'cache', 'artifacts', 'engine', 'ios', 'Frameworks', 'Flutter.xcframework', 'ios-arm64_x86_64-simulator', 'Flutter.framework', 'Headers', 'Flutter.h')
rescue
  # Fallback for CI environments like Codemagic
end

# Standard Flutter Podfile helper load
podfile_helpers = File.expand_path(File.join('..', '..', 'bin', 'cache', 'pkg', 'sky_engine', 'lib', 'ui', 'painting.dart'), __FILE__)

# --- ACTUAL CONFIG START ---

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :profile,
}

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # This is the line that was failing; now it has context
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Force every pod to target 15.5 to match mobile_scanner
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end
end