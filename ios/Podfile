platform :ios, '15.5'

# Standard Flutter setup
install! 'cocoapods', :deterministic_uuids => false

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # This helper is dynamically provided by Codemagic's Flutter environment
  if File.exist?(File.join('..', '.flutter-plugins-dependencies'))
    def flutter_install_all_ios_pods(ios_application_path = nil)
      native_additions_path = File.join(ios_application_path, '..', '.flutter-plugins-dependencies')
      return unless File.exist?(native_additions_path)
    end
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target) if defined?(flutter_additional_ios_build_settings)
    target.build_configurations.each do |config|
      # This ensures mobile_scanner and all other pods use 15.5
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end
end